# Copy to .streamlit/secrets.toml for local dev

[admin]
password = "change-me"
# Or multiple admins:
# passwords = "pass-one, pass-two"

# Optional: persistent Postgres (Supabase, Neon, etc.)
# DATABASE_URL = "postgresql://user:pass@host:5432/dbname"

# Public app URL for share links & QR codes
APP_URL = "https://nitjoint.streamlit.app"

# Optional Telegram bot (run: python -m nit_joint.bot)
# TELEGRAM_BOT_TOKEN = "your-bot-token"
